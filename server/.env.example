# Server port
PORT=3001

# Coinbase Exchange WebSocket URL (public feed)
# Sandbox: wss://ws-feed-public.sandbox.exchange.coinbase.com
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Coinbase Exchange REST API base URL (public, no auth required)
COINBASE_REST_URL=https://api.exchange.coinbase.com

# Coinbase WebSocket reconnect delay in milliseconds
COINBASE_RECONNECT_DELAY_MS=5000

# How often (ms) to poll the REST API for order book snapshots
# Note: the WS level2 channel now requires authentication, so we use REST
ORDER_BOOK_POLL_INTERVAL_MS=1000

# Allowed CORS origin for the React client
CLIENT_ORIGIN=http://localhost:5173

# How often (ms) to push order book snapshots to subscribed clients
PUSH_INTERVAL_MS=50

# Number of price levels (bids/asks) to include in each order book snapshot
ORDER_BOOK_DEPTH=20
